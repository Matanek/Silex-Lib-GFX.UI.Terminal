use GFX.Input.Keyboard
use GFX.UI
use GFX.UI.Terminal
use STD.Math

func status(arguments:str) str { return "accepted: " + arguments }

func control_modifiers() Keyboard.Modifiers {
    return Keyboard.Modifiers(
        shift:false, control:true, alt:false, system:false,
        left_shift:false, right_shift:false, level5:false,
        left_control:true, right_control:false,
        left_alt:false, right_alt:false,
        left_system:false, right_system:false, mode:false,
        caps_lock:false, num_lock:false, scroll_lock:false
    )
}

test "consumer creates a system shell as a UI view" {
    var process = Terminal.ShellSession(size:Terminal.Size(columns:20, rows:4))
    var shell = Terminal.Shell(session:process)
    var session = UI.Session(shell)
    assert(session.drawing(240, 140).command_count() > 0)
    assert(process.is_running())
    match process.close() {
        failure(error) => { panic(error.operation + ": " + error.detail) }
        success => {}
    }
}

test "consumer controls shell sessions independently" {
    var first = Terminal.ShellSession(size:Terminal.Size(columns:20, rows:4))
    var second = Terminal.ShellSession(size:Terminal.Size(columns:20, rows:4))
    var first_exits = 0
    var second_exits = 0
    var first_view = Terminal.Shell(
        session:first,
        close_on_interrupt:true,
        on_exit:func() { first_exits++ }
    )
    var second_view = Terminal.Shell(
        session:second,
        on_exit:func() { second_exits++ }
    )
    let tabs:UI.View[] = [
        first_view,
        second_view
    ]
    var runtime = UI.Runtime(UI.Column(tabs), autofocus:true)
    var drawing = runtime.drawing(240, 280)
    assert(drawing.command_count() > 0)
    assert(runtime.accepts_text_input())

    assert(runtime.key_pressed(Keyboard.Key.c, control_modifiers()))
    var attempts = 0
    while first.is_running() && attempts < 100000 {
        runtime.update(0.001)
        attempts++
    }
    assert(!first.is_running())
    assert(second.is_running())
    assert(first_exits == 1)
    assert(second_exits == 0)
    match second.close() {
        failure(error) => { panic(error.operation + ": " + error.detail) }
        success => {}
    }
    attempts = 0
    while second.is_running() && attempts < 100000 {
        runtime.update(0.001)
        attempts++
    }
    assert(!second.is_running())
    assert(first_exits == 1)
    assert(second_exits == 1)
}

test "consumer can build a themed terminal drawing" {
    var screen = Terminal.Screen(Terminal.Size(columns:20, rows:4))
    let initial_revision = screen.revision()
    screen.feed("Silex terminal")
    assert(screen.revision() > initial_revision)
    var view = Terminal.drawing(screen, Terminal.ViewSettings(cursor_visible:false))
    assert(view.command_count() > 1)

}

test "consumer composes an interactive terminal console as a UI view" {
    var terminal = Terminal.Console(
        commands:[Terminal.Command(
            "status",
            status,
            description:"Show application status"
        )],
        size:Terminal.Size(columns:20, rows:4),
        prompt:"silex> ",
        welcome:["Application console"],
        settings:Terminal.ViewSettings(cursor_visible:true)
    )
    let children:UI.View[] = [UI.Text("Console"), terminal]
    var root = UI.Column(children)
    var runtime = UI.Runtime(root)

    var drawing = runtime.drawing(240, 140)
    assert(drawing.command_count() > 2)
    assert(runtime.pointer_pressed(Math.Vec2(20.0, 40.0)))
    assert(runtime.accepts_text_input())
    assert(runtime.insert_text("status"))
    assert(runtime.key_pressed(Keyboard.Key.enter))
    assert(runtime.update(0.016))
}

use GFX.UI
use GFX.UI.Terminal
use GFX.Canvas
use GFX.Input.Keyboard
use STD.Text
use STD.Console
use STD.Error
use STD.Math
use STD.Process
use STD.Subprocess

static class ConsoleProbe {
    var argument_count:int = 0

    func status(arguments:str) str {
        ConsoleProbe.argument_count = arguments.count()
        return "application is running"
    }
}

test "screen interprets cursor movement colors and UTF-8" {
    var screen = Terminal.Screen(Terminal.Size(columns:12, rows:3))
    let initial_revision = screen.revision()
    screen.feed("hello")
    screen.feed("\nmonde")
    screen.feed("\u{1b}[1;1H\u{1b}[31mR\u{1b}[0m")
    screen.feed("\u{1b}[?25l\u{1b}]0;hidden title\u{7}")
    assert(Text.starts_with(screen.line(0), "Rello"))
    assert(Text.starts_with(screen.line(1), "monde"))
    assert(screen.cell(0, 0).foreground == 1)
    assert(screen.revision() > initial_revision)
    var drawing = Terminal.drawing(screen)
    assert(drawing.command_count() > 2)
    var snapshot = drawing.snapshot(144, 84)
    var layers = snapshot.text_layers()
    assert(layers.count() <= screen.rows())
}

test "terminal text runs keep their full width at Retina scale" {
    var screen = Terminal.Screen(Terminal.Size(columns:9, rows:1))
    screen.feed("\u{1b}[36mExa\u{1b}[34mgit\u{1b}[31mma\u{1b}[0m")
    var drawing = Terminal.drawing(screen)
    var layers = drawing.snapshot(120, 40).text_layers()
    assert(layers.count() == 3)
    let first = layers[0].text_layer(2.0)
    let second = layers[1].text_layer(2.0)
    let third = layers[2].text_layer(2.0)
    assert(first.size.x == 30.0)
    assert(first.image.width() == 60)
    assert(second.size.x == 30.0)
    assert(second.image.width() == 60)
    assert(third.size.x == 20.0)
    assert(third.image.width() == 40)
}

test "terminal drawing rebuilds only touched row paint caches" {
    var screen = Terminal.Screen(Terminal.Size(columns:8, rows:3))
    screen.feed("first\nsecond")
    var first = Terminal.drawing(screen)
    assert(first.command_count() > 1)
    assert(screen.paint_cache_build_count() == 3)
    var unchanged = Terminal.drawing(screen)
    assert(unchanged.command_count() == first.command_count())
    assert(screen.paint_cache_build_count() == 3)
    screen.feed("x")
    var changed = Terminal.drawing(screen)
    assert(changed.command_count() > 1)
    assert(screen.paint_cache_build_count() == 4)
}

test "terminal scrolling retains paint caches for shifted rows" {
    var screen = Terminal.Screen(Terminal.Size(columns:8, rows:3))
    screen.feed("one\ntwo\nthree")
    var first = Terminal.drawing(screen)
    assert(first.command_count() > 1)
    assert(screen.paint_cache_build_count() == 3)
    screen.feed("\nfour")
    var scrolled = Terminal.drawing(screen)
    assert(scrolled.command_count() > 1)
    assert(screen.paint_cache_build_count() == 4)
    assert(screen.line(0) == "two     ")
    assert(screen.line(1) == "three   ")
    assert(screen.line(2) == "four    ")
}

test "terminal views use a monospace font by default" {
    var drawing = Canvas.Canvas()
    var settings = Terminal.ViewSettings()
    if let font = settings.font {
        var style = Canvas.TextStyle(size:settings.font_size, font:font)
        let narrow = drawing.measure_text("iiii", style)
        let wide = drawing.measure_text("mmmm", style)
        assert(narrow.width == wide.width)
        assert(settings.cell_width == 10.0)
    } else { assert(false) }
}

test "terminal console views invalidate their UI runtime on screen changes" {
    ConsoleProbe.argument_count = 0
    var console = Terminal.Console(
        commands:[Terminal.Command("status", ConsoleProbe.status)],
        size:Terminal.Size(columns:24, rows:4)
    )
    var runtime = UI.Runtime(console)
    var initial = runtime.drawing(144, 84)
    assert(initial.command_count() > 1)
    assert(!runtime.update(0.016))
    assert(runtime.pointer_pressed(Math.Vec2(10.0, 10.0)))
    assert(runtime.insert_text("status verbose"))
    assert(runtime.key_pressed(Keyboard.Key.enter))
    assert(ConsoleProbe.argument_count == 7)
    assert(runtime.update(0.016))
    var changed = runtime.drawing(144, 84)
    assert(changed.command_count() > initial.command_count())
}

test "screen scrolls at its bottom edge" {
    var screen = Terminal.Screen(Terminal.Size(columns:4, rows:2))
    screen.feed("one\ntwo\ntri")
    assert(Text.starts_with(screen.line(0), "two"))
    assert(Text.starts_with(screen.line(1), "tri"))
}

test "screen preserves its visible cells when resized" {
    var screen = Terminal.Screen(Terminal.Size(columns:4, rows:2))
    screen.feed("one\ntwo")
    screen.resize(Terminal.Size(columns:6, rows:3))
    assert(Text.starts_with(screen.line(0), "one"))
    assert(Text.starts_with(screen.line(1), "two"))
}

test "application console dispatches declarative commands without spawning a shell" {
    ConsoleProbe.argument_count = 0
    var console = Terminal.Console(commands:[
        Terminal.Command(
            "status",
            ConsoleProbe.status,
            description:"Show application status"
        )
    ])
    var session = UI.Session(console)
    var drawing = session.drawing(824, 504)
    assert(drawing.command_count() > 1)
}

test "system session feeds the shared terminal screen" {
    func child() {
        if value = Console.read_line() { Console.write("\u{1b}[32msystem:" + value + "\u{1b}[0m") }
    }
    func parent(executable:str) Result<void, Error> {
        let command = Subprocess.TerminalCommand(
            executable:executable,
            arguments:["--gfx-terminal-child"],
            current_directory:null,
            inherit_environment:true,
            environment:[Subprocess.EnvironmentChange.set("TERM", "xterm-256color")],
            size:Terminal.Size(columns:40, rows:4)
        )
        var session = try Terminal.spawn(command) else error { return Result<void,Error>.failure(error) }
        var terminal = Terminal.View(session)
        var interface = UI.Runtime(terminal)
        var initial = interface.drawing(424, 104)
        assert(initial.command_count() > 0)
        try session.write("ready\n") else error { return Result<void,Error>.failure(error) }
        var changed = false
        var attempts = 0
        while session.exit_status() == null && attempts < 100000 {
            changed = interface.update(0.001) || changed
            attempts++
        }
        assert(session.exit_status() != null)
        assert(changed)
        assert(interface.pointer_pressed(Math.Vec2(10.0, 10.0)))
        assert(!interface.accepts_text_input())
        assert(!interface.insert_text("after exit"))
        var visible = ""
        var row = 0
        while row < session.screen().rows() { visible = visible + session.screen().line(row); row++ }
        assert(Text.contains(visible, "system:ready"))
        return Result<void, Error>.success()
    }
    func dispatch() Result<void, Error> {
        let arguments = try Process.arguments() else error { return Result<void,Error>.failure(error) }
        if arguments.count() > 1 && arguments[1] == "--gfx-terminal-child" { child(); return Result<void, Error>.success() }
        return (try parent(try Process.executable_path() else error { return Result<void,Error>.failure(error) }))
    }
    match (try dispatch()) { failure(error) => { panic(error.operation + ": " + error.detail) }; success => {} }
}

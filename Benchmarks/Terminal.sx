use GFX.Terminal
use STD.Time.Stopwatch

func populated_screen() Terminal.Screen {
    var screen = Terminal.Screen(Terminal.Size(columns:100, rows:30))
    var row = 0
    while row < 29 {
        screen.feed("silex> compile project --release  completed in 42 ms  warning: none  status: ready")
        if row < 28 { screen.feed("\n") }
        row++
    }
    return screen
}

func render_full(screen:@Terminal.Screen) int {
    var drawing = Terminal.drawing(screen)
    var snapshot = drawing.snapshot(1024, 624)
    let text = snapshot.text()
    assert(text.width() > 0)
    assert(text.height() > 0)
    return drawing.command_count()
}

func main() {
    var full_screen = populated_screen()
    let command_count = render_full(full_screen)

    var full = Stopwatch()
    full.start()
    var frame = 0
    while frame < 10 {
        full_screen.feed("x")
        render_full(full_screen)
        frame++
    }
    full.stop()

    var incremental_screen = populated_screen()
    var view = Terminal.View()
    for row in view.changed_rows(incremental_screen) {
        var initial = view.line_drawing(incremental_screen, row)
        var snapshot = initial.snapshot(view.width(incremental_screen), view.row_height())
        let text = snapshot.text()
    }

    var incremental = Stopwatch()
    incremental.start()
    var rendered_rows = 0
    frame = 0
    while frame < 10 {
        incremental_screen.feed("x")
        for row in view.changed_rows(incremental_screen) {
            var drawing = view.line_drawing(incremental_screen, row)
            var snapshot = drawing.snapshot(view.width(incremental_screen), view.row_height())
            let text = snapshot.text()
            rendered_rows++
        }
        frame++
    }
    incremental.stop()

    assert(rendered_rows == 10)
    print(
        "full_10_keys_ms=", full.get_elapsed_milliseconds(),
        " incremental_10_keys_ms=", incremental.get_elapsed_milliseconds(),
        " rendered_rows=", rendered_rows,
        " commands=", command_count
    )
}

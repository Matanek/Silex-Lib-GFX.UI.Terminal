use GFX.Canvas
use GFX.Color
use GFX.Input
use GFX.UI
use GFX.UI.Input as UIInput
use GFX.UI.Terminal
use GFX.Viewer
use STD.Process

static struct Layout {
    let columns:int = 80
    let rows:int = 24
    let width:int = 900
    let height:int = 580
}

func check_only() bool {
    match Process.arguments() {
        failure(error) => { return false }
        success(arguments) => {
            for argument in arguments {
                if argument == "--check" { return true }
            }
        }
    }
    return false
}

func execute(command:str, console:&Terminal.Console) {
    if command == "help" { console.respond("commands: help, status, clear") }
    elif command == "status" { console.respond("application is running") }
    elif command == "clear" { console.clear() }
    elif command == "" { console.respond("") }
    else { console.respond("unknown command: " + command) }
}

func interface(console:Terminal.Console) UI.Column {
    var heading = UI.Text("Application console")
    heading.style.font_size = 22.0
    heading.style.font_weight = UI.FontWeight.bold

    var terminal = Terminal.ConsoleView(console, on_submit:execute)
    terminal.style.grow = 1.0

    let children:UI.View[] = [heading, terminal]
    var root = UI.Column(children)
    root.style.padding = UI.Insets(18.0)
    root.style.gap = 12.0
    root.style.background = Color.slate_900()
    root.style.foreground = Color.slate_100()
    return root
}

class ConsoleSession:Viewer.CanvasSession {
    private var runtime:UI.Runtime? = null

    init(root:UI.View) { self.runtime = UI.Runtime(root) }

    func drawing(width:int, height:int) Canvas.Canvas {
        if var runtime = self.runtime { return runtime.drawing(width, height) }
        panic("GFX.UI.Terminal console has no UI runtime")
    }

    func handle(event:@Input.Event) bool {
        if var runtime = self.runtime { return UIInput.handle(runtime, event) }
        return false
    }

    func update(delta:float) bool {
        if var runtime = self.runtime { return runtime.update(delta) }
        return false
    }

    func accepts_text_input() bool {
        if var runtime = self.runtime { return runtime.accepts_text_input() }
        return false
    }
}

func main() {
    var console = Terminal.Console(
        Terminal.Size(columns:Layout.columns, rows:Layout.rows),
        prompt:"silex> "
    )
    console.write_line("GFX.UI.Terminal application console")
    console.write_line("type 'help' to list commands")

    var root = interface(console)
    var session = ConsoleSession(root)
    if check_only() {
        var drawing = session.drawing(Layout.width, Layout.height)
        assert(drawing.command_count() > 4)
        print("GFX.UI.Terminal application console rendered")
        return
    }

    Viewer.show(session, Viewer.CanvasSettings(
        width:Layout.width,
        height:Layout.height,
        title:"GFX.UI.Terminal — Application console",
        background:Color.slate_950()
    ))
}

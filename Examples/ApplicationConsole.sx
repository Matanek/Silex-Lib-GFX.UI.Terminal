use GFX.Color
use GFX.UI
use GFX.UI.Terminal
use GFX.Viewer
use STD.Process

static struct Layout {
    let columns:int = 80
    let rows:int = 24
    let width:int = 900
    let height:int = 580
}

func check_only() bool {
    match Process.arguments() {
        failure(error) => { return false }
        success(arguments) => {
            for argument in arguments {
                if argument == "--check" { return true }
            }
        }
    }
    return false
}

func status(arguments:str) str { return "application is running" }
func echo(arguments:str) str { return arguments }

func interface() UI.Column {
    var heading = UI.Text("Application console")
    heading.style.font_size = 22.0
    heading.style.font_weight = UI.FontWeight.bold

    var terminal = Terminal.Console(
        commands:[
            Terminal.Command(
                "status",
                status,
                description:"Show the application status"
            ),
            Terminal.Command(
                "echo",
                echo,
                description:"Print the provided text"
            )
        ],
        size:Terminal.Size(columns:Layout.columns, rows:Layout.rows),
        prompt:"silex> ",
        welcome:[
            "GFX.UI.Terminal application console",
            "type 'help' to list commands"
        ]
    )
    terminal.style.grow = 1.0

    let children:UI.View[] = [heading, terminal]
    var root = UI.Column(children)
    root.style.padding = UI.Insets(18.0)
    root.style.gap = 12.0
    root.style.background = Color.slate_900()
    root.style.foreground = Color.slate_100()
    return root
}

func main() {
    var root = interface()
    var session = UI.Session(root)
    if check_only() {
        var drawing = session.drawing(Layout.width, Layout.height)
        assert(drawing.command_count() > 4)
        print("GFX.UI.Terminal application console rendered")
        return
    }

    Viewer.show(session, Viewer.CanvasSettings(
        width:Layout.width,
        height:Layout.height,
        title:"GFX.UI.Terminal — Application console",
        background:Color.slate_950()
    ))
}

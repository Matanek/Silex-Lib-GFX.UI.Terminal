use GFX.Color
use GFX.UI
use GFX.UI.Terminal
use GFX.Viewer
use STD.Process

static struct Layout {
    let columns:int = 100
    let rows:int = 30
    let width:int = 1060
    let height:int = 680
}

func check_only() bool {
    match Process.arguments() {
        failure(error) => { return false }
        success(arguments) => {
            for argument in arguments {
                if argument == "--check" { return true }
            }
        }
    }
    return false
}

func interface() UI.Column {
    var heading = UI.Text("System terminal")
    heading.style.font_size = 22.0
    heading.style.font_weight = UI.FontWeight.bold

    var terminal = Terminal.Shell(size:Terminal.Size(
        columns:Layout.columns,
        rows:Layout.rows
    ))
    terminal.style.grow = 1.0

    let children:UI.View[] = [heading, terminal]
    var root = UI.Column(children)
    root.style.padding = UI.Insets(18.0)
    root.style.gap = 12.0
    root.style.background = Color.slate_900()
    root.style.foreground = Color.slate_100()
    return root
}

func run_terminal() {
    var root = interface()
    Viewer.show(UI.Session(root), Viewer.CanvasSettings(
        width:Layout.width,
        height:Layout.height,
        title:"GFX.UI.Terminal — System terminal",
        background:Color.slate_950()
    ))
}

func main() {
    if check_only() {
        var console = Terminal.Console(
            size:Terminal.Size(columns:40, rows:6),
            welcome:["GFX.UI.Terminal check"]
        )
        var session = UI.Session(console)
        var drawing = session.drawing(424, 144)
        assert(drawing.command_count() > 2)
        print("GFX.UI.Terminal system view rendered")
        return
    }
    run_terminal()
}
